# Temporary authoring tape for measuring the live-object blockage in the
# Academy exit corridor.  This is intentionally a checked-in oracle tape so
# the failed route and its replacement remain reproducible.
400 . skip_fade
4 S start1
200 . wait
4 S start2
250 . menu_appears
4 S confirm_start
300 . into_field
repeat 336
4 B
12 .
end
400 . await_control
120 . settle_after_opening

# Detour around the observed object at (37,16), generated by route.py with
# the blocked cell (38,16) supplied to its planner.
24 U
88 L
8 D
104 L
16 D
56 L
120 . wait_for_wander

# Probe the south detour, then return to rest if the corridor remains closed.
16 D
120 . south_wait
16 R
120 . inspect_detour
