#!/usr/bin/env python3
"""ds-lane: executable entry point for the `ds_lane` package beside it.

The implementation is stdlib-only and lives in tools/ds_lane/ (config,
preflight, receipts, lanes, supervisor, cli); this shim only puts that
directory on sys.path and calls the CLI. It is normally invoked through the
~/.local/bin/ds-lane symlink and the detached supervisor re-enters through
this same file, so it resolves its own real path first.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from ds_lane.cli import main  # noqa: E402  (import follows the sys.path setup)

if __name__ == "__main__":
    main()
