{
  "$defs": {
    "MusicHeader": {
      "additionalProperties": false,
      "description": "A music record's header.",
      "properties": {
        "fm_channel_count": {
          "description": "FM channel descriptors.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "header_size_bytes": {
          "description": "Header and descriptors.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "psg_channel_count": {
          "description": "PSG channel descriptors.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "tempo_reload": {
          "description": "Header byte 5, the global tempo reload.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "tick_multiplier": {
          "description": "Header byte 4.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "voice_count": {
          "description": "Whole 25-byte voices in the table.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "voice_padding_bytes": {
          "description": "Zero bytes after the last voice.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "voice_table_relative": {
          "description": "The voice table's offset from the record start.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "voice_table_rom_offset": {
          "description": "The voice table, `0xNNNNNN`.",
          "type": "string"
        }
      },
      "required": [
        "voice_table_relative",
        "voice_table_rom_offset",
        "fm_channel_count",
        "psg_channel_count",
        "tick_multiplier",
        "tempo_reload",
        "header_size_bytes",
        "voice_count",
        "voice_padding_bytes"
      ],
      "type": "object"
    },
    "RawRecord": {
      "additionalProperties": false,
      "description": "A record's place in the ROM and its raw copy.",
      "properties": {
        "end_offset_exclusive": {
          "description": "End, exclusive: the next record's start.",
          "type": "string"
        },
        "raw_file": {
          "description": "Raw copy, relative to `sound/`.",
          "type": "string"
        },
        "raw_sha256": {
          "description": "SHA-256 of the raw copy.",
          "type": "string"
        },
        "rom_offset": {
          "description": "Start, `0xNNNNNN`.",
          "type": "string"
        },
        "size_bytes": {
          "description": "Length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rom_offset",
        "end_offset_exclusive",
        "size_bytes",
        "raw_file",
        "raw_sha256"
      ],
      "type": "object"
    },
    "Record": {
      "additionalProperties": false,
      "description": "One music or SFX record.",
      "properties": {
        "header": {
          "$ref": "#/$defs/MusicHeader",
          "description": "The record's header."
        },
        "id": {
          "description": "Retail sound id.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "id_hex": {
          "description": "The id as `0xNN`.",
          "type": "string"
        },
        "map_usage_count": {
          "description": "Music only: how many field maps select this record.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "record": {
          "$ref": "#/$defs/RawRecord",
          "description": "Where the record is and its raw copy."
        },
        "symbol": {
          "description": "Retail symbol.",
          "type": "string"
        },
        "tracks": {
          "description": "The record's tracks, in descriptor order.",
          "items": {
            "$ref": "#/$defs/Track"
          },
          "type": "array"
        },
        "voices": {
          "description": "The record's whole FM voice table.",
          "items": {
            "$ref": "#/$defs/Voice"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "id_hex",
        "symbol",
        "record",
        "header",
        "voices",
        "tracks"
      ],
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "description": "One track and its static decode.",
      "properties": {
        "decode": {
          "$ref": "#/$defs/TrackDecode",
          "description": "What the static walk saw."
        },
        "index": {
          "description": "Index among the record's descriptors of this family.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "initial": {
          "$ref": "#/$defs/TrackInitial",
          "description": "The descriptor's initial values."
        },
        "instruments_used": {
          "description": "FM voices selected by `EF`, ascending.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/TrackFamily",
          "description": "The descriptor's family."
        },
        "psg_instruments_used": {
          "description": "PSG envelopes selected by `F5`, ascending.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/TrackSource",
          "description": "Where the track starts."
        },
        "track_id": {
          "description": "`music:NN:fm:I`, `music:NN:psg:I` or `sfx:NN:I`.",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "kind",
        "index",
        "source",
        "initial",
        "instruments_used",
        "psg_instruments_used",
        "decode"
      ],
      "type": "object"
    },
    "TrackDecode": {
      "additionalProperties": false,
      "description": "What the static walk of one track saw.",
      "properties": {
        "command_counts": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Primary command counts keyed by `NN`.",
          "type": "object"
        },
        "command_opcodes_seen": {
          "description": "Primary command opcodes met, as `0xNN`, ascending.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "has_track_end": {
          "description": "Whether an `F2` is reachable.",
          "type": "boolean"
        },
        "max_call_depth": {
          "description": "Deepest `F8` nesting.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "meta_counts": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Meta command counts keyed by `NN`.",
          "type": "object"
        },
        "meta_opcodes_seen": {
          "description": "`FF` meta opcodes met, as `0xNN`, ascending.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reachable_byte_count": {
          "description": "Distinct bytes on a reachable path.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reachable_instruction_states": {
          "description": "Distinct (position, call stack) states reached.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sequence_byte_values_seen": {
          "description": "Every byte value on a reachable path, as `0xNN`, ascending.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "reachable_instruction_states",
        "reachable_byte_count",
        "command_opcodes_seen",
        "command_counts",
        "meta_opcodes_seen",
        "meta_counts",
        "sequence_byte_values_seen",
        "max_call_depth",
        "has_track_end"
      ],
      "type": "object"
    },
    "TrackFamily": {
      "description": "A track descriptor's family.",
      "oneOf": [
        {
          "const": "fm",
          "description": "A music FM descriptor.",
          "type": "string"
        },
        {
          "const": "psg",
          "description": "A music PSG descriptor.",
          "type": "string"
        },
        {
          "const": "sfx",
          "description": "An SFX descriptor; its channel byte names the channel.",
          "type": "string"
        }
      ]
    },
    "TrackInitial": {
      "additionalProperties": false,
      "description": "A descriptor's initial values; which are present depends on the family.",
      "properties": {
        "channel_byte": {
          "description": "SFX: its low byte, the channel.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "channel_word": {
          "description": "SFX: the descriptor's channel word.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "modulation_envelope": {
          "description": "Music PSG: the modulation envelope byte.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "transpose": {
          "description": "Transpose byte, unsigned as stored.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "volume": {
          "description": "Volume byte, unsigned as stored.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "volume_envelope": {
          "description": "Music PSG: the volume envelope byte.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "transpose",
        "volume"
      ],
      "type": "object"
    },
    "TrackSource": {
      "additionalProperties": false,
      "description": "A track's start.",
      "properties": {
        "raw_descriptor_hex": {
          "description": "The descriptor, as lowercase hex.",
          "type": "string"
        },
        "record_end_exclusive": {
          "description": "The record's end, `0xNNNNNN`.",
          "type": "string"
        },
        "record_relative_offset": {
          "description": "Start, from the record start.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rom_offset": {
          "description": "Start, `0xNNNNNN`.",
          "type": "string"
        }
      },
      "required": [
        "rom_offset",
        "record_relative_offset",
        "record_end_exclusive",
        "raw_descriptor_hex"
      ],
      "type": "object"
    },
    "Voice": {
      "additionalProperties": false,
      "description": "One 25-byte FM voice.",
      "properties": {
        "algorithm_feedback": {
          "description": "Byte 0.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "index": {
          "description": "Index in the record's voice table.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "operator_registers": {
          "description": "Bytes 1-20.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "operator_total_levels": {
          "description": "Bytes 21-24.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "raw_hex": {
          "description": "The voice, as lowercase hex.",
          "type": "string"
        },
        "rom_offset": {
          "description": "Start, `0xNNNNNN`.",
          "type": "string"
        },
        "size_bytes": {
          "description": "Always 25.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "index",
        "rom_offset",
        "size_bytes",
        "raw_hex",
        "algorithm_feedback",
        "operator_registers",
        "operator_total_levels"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sparse JSON patch schema for `patches/sound/music.json`, generated from `psiv-data` Rust types with strict unknown-field rejection (`additionalProperties: false`).",
  "properties": {
    "format_version": {
      "description": "[`SOUND_FORMAT_VERSION`].",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "description": "`\"music_records\"`.",
      "type": "string"
    },
    "records": {
      "additionalProperties": false,
      "description": "The music records.",
      "properties": {
        "id_first": {
          "description": "The sound id of the table's first record.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "records": {
          "description": "The records, in table order.",
          "items": {
            "$ref": "#/$defs/Record"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "rom": {
      "additionalProperties": false,
      "description": "The source ROM.",
      "properties": {
        "sha256": {
          "description": "Lowercase SHA-256 of the image.",
          "type": "string"
        },
        "size_bytes": {
          "description": "Image size.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "title": "PSIV Mod Patch Schema (sound/music.json)",
  "type": "object"
}
