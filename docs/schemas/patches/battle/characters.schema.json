  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sparse JSON patch schema for `patches/battle/characters.json`, generated from `psiv-data` Rust types with strict unknown-field rejection (`additionalProperties: false`).",
  "properties": {
    "characters": {
      "description": "The records, in `Character_Stats` order.",
      "oneOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/CharacterPatch"
          },
          "description": "Sparse ID-keyed patch map keyed by `character_id`.",
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "type": "object"
        },
        {
          "description": "Array of partial record patches, each carrying `character_id`.",
          "items": {
            "$ref": "#/$defs/CharacterPatch",
            "required": [
              "character_id"
            ]
          },
          "type": "array"
        }
      ]
    },
    "count": {
      "description": "How many records the file declares.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "format_version": {
      "const": 2,
      "description": "The pack format that wrote this.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "PSIV Mod Patch Schema (battle/characters.json)",
  "type": "object"
}
