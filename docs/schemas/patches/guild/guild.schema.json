{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sparse JSON patch schema for `patches/guild/guild.json`, generated from `psiv-data` Rust types with strict unknown-field rejection (`additionalProperties: false`).",
  "properties": {
    "closed_line": {
      "items": {
        "items": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "type": "array"
    },
    "done_line": {
      "items": {
        "items": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "type": "array"
    },
    "font_line": {
      "items": {
        "items": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "type": "array"
    },
    "format_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "kind": {
      "type": "string"
    },
    "money": {
      "items": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "names": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pending": {
      "type": "string"
    },
    "rom_sha256": {
      "description": "SHA-256 digest as 64 hexadecimal characters.",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-fA-F]{64}$",
      "type": "string"
    },
    "rows": {
      "items": {
        "items": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "maxItems": 8,
        "minItems": 8,
        "type": "array"
      },
      "type": "array"
    },
    "window": {
      "additionalProperties": false,
      "description": "One `WinGroup_Event` record: a window's size and position in cells.",
      "properties": {
        "height": {
          "description": "Height in cells, frame included.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "The window id `Window_Create` is called with.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "width": {
          "description": "Width in cells, frame included.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "x": {
          "description": "Left cell.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "description": "Top cell.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "title": "PSIV Mod Patch Schema (guild/guild.json)",
  "type": "object"
}
