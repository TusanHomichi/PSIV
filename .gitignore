# User-supplied ROMs / generated local data.
# Local inputs are anchored and have no trailing slash, so a worktree that
# symlinks one in (ds-lane --link, a subagent's ln -s) cannot stage the link:
# "dir/" matches only a directory, and a committed self-link once replaced the
# main checkout's oracle/gpgx-src on checkout (tests/test_gitignore_inputs.py).
/roms
/generated
/example-output
/reference
*.bin
*.gen
*.smd
Phantasy Star IV*.md
*.zip

# Python
__pycache__/
*.pyc
.venv/
/runtime-pack
# A pack build's versions, links and staging beside any pack directory
# (psiv_tools/pack_swap.py): .<name>.v<UTC stamp>-<pid>,
# .<name>.build-<pid>-<hex> and .<name>.link-<pid>-<hex>. The shapes are
# exact, so a tracked dotfile or an unrelated name is not ignored.
.*.v[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]Z-[0-9]*
.*.build-[0-9]*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]
.*.link-[0-9]*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]
/saves
rust/target/
godot/.godot/
/oracle/gpgx-src
/oracle/core
/oracle/bin
/oracle/logs
/oracle/frames
/oracle/states
/oracle/layouts
/build
oracle/tmp_*
oracle/fixtures/battle_animation_art/*.png
